{
  "name": "ka-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kabra Architects project dashboard. A plain website on Vercel + Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "node scripts/audit-seed.mjs",
    "audit:write": "node scripts/audit-seed.mjs --write",
    "seed:dry": "node scripts/seed.mjs --dry-run",
    "seed": "node scripts/seed.mjs",
    "seed:sql": "node scripts/seed.mjs --emit-sql",
    "test": "npm run test:js && ./test/run.sh",
    "build:migrations": "./scripts/build-migrations.sh",
    "test:js": "node --test test/js/*.test.mjs",
    "test:sql": "./test/run.sh && ./test/converge.sh",
    "test:converge": "./test/converge.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
