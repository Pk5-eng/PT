# Seeding only. The service role key bypasses RLS and must never reach the
# browser or be committed. Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The app (Phase 2 onward) uses the anon key only. RLS is the boundary.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
